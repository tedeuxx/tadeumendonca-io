# Copy to `.env` and fill in. Both variables are OPTIONAL — the app builds and runs with
# neither, which is why this file did not exist until someone checked (#255).
#
# There are no secrets here and there is no backend to point at. A measurement ID is not a
# credential: it identifies a property, it does not authorise anything, and it is public in
# the shipped bundle by construction. Committing this file is safe; committing `.env` is not
# the point either way — it is gitignored because that is the habit worth keeping, not
# because either value would hurt.

# Google Analytics 4 measurement ID. LEFT EMPTY, ANALYTICS IS FULLY INERT: no script is
# loaded, no cookie is set, and the consent bar does not render at all. That is deliberate —
# the site's property is that nothing third-party loads until a reader says yes, and an
# unconfigured build should not even ask.
VITE_GA_MEASUREMENT_ID=

# The canonical origin, used for absolute canonical/hreflang/OG URLs at build time.
# Defaults to https://tadeumendonca.io when unset. Override it only if you are serving a
# fork from your own domain — leaving your fork advertising this one's canonical URLs would
# hand it your SEO and your OG cards.
VITE_SITE_URL=https://tadeumendonca.io
